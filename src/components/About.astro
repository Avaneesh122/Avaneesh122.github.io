  }

  .about-index {
    position: relative;
  }

  .big-index {
    display: none;
  }

  @media (min-width: 860px) {
    .big-index {
      display: block;
      font-size: 8rem;
      line-height: 1;
      color: var(--line);
      margin-top: 0.4rem;
      user-select: none;
    }
  }

  .about-body {
    max-width: 68ch;
  }

  .lede {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.3rem, 2.4vw, 1.7rem);
