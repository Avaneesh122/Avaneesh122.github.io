---
const DISCORD_ID = "527754865540202498";
---

<section class="now-playing shell" aria-label="Now playing on Spotify">
  <div class="np-inner edge-pad">
    <div class="np-label mono">
      <span class="np-eq" id="np-eq" aria-hidden="true"><span></span><span></span><span></span></span>
      Now Playing
    </div>
    <a class="np-track np-idle" id="np-track" href="#" target="_blank" rel="noreferrer">
      <img class="np-art" id="np-art" alt="" hidden />
      <span class="np-meta">
        <span class="np-song" id="np-song">Checking Spotify…</span>
        <span class="np-artist mono" id="np-artist"></span>
      </span>
    </a>
  </div>
  <div class="rule-dim"></div>
</section>

<style>
  .now-playing {
    padding-top: 1.5rem;
    padding-bottom: 1.5rem;
  }

  .np-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .np-label {
    display: flex;
    align-items: center;
    gap: 0.8em;
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg-faint);
    white-space: nowrap;
  }

  .np-eq {
    display: inline-flex;
    align-items: flex-end;
    gap: 3px;
    height: 16px;
  }

  .np-eq span {
    width: 3px;
    height: 5px;
    background: var(--fg-faint);
    transition: background 0.2s ease;
  }

  .np-eq.is-live span {
    background: var(--accent);
    animation: np-bounce 0.9s ease-in-out infinite;
  }

  .np-eq.is-live span:nth-child(1) {
    animation-delay: -0.6s;
  }

  .np-eq.is-live span:nth-child(2) {
    animation-delay: -0.3s;
  }

  .np-eq.is-live span:nth-child(3) {
    animation-delay: 0s;
  }

  @keyframes np-bounce {
    0%,
    100% {
      height: 4px;
    }
    50% {
      height: 16px;
    }
  }

  .np-track {
    display: flex;
    align-items: center;
    gap: 1rem;
    color: var(--fg-dim);
    text-decoration: none;
    max-width: 100%;
    overflow: hidden;
    transition: color 0.15s ease;
  }

  .np-track:not(.np-idle):hover {
    color: var(--accent);
  }

  .np-track.np-idle {
    pointer-events: none;
  }

  .np-art {
    width: 48px;
    height: 48px;
    object-fit: cover;
    flex-shrink: 0;
    border: 1px solid var(--line);
  }

  .np-meta {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    overflow: hidden;
  }

  .np-song {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.05rem;
    color: var(--fg);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .np-track:not(.np-idle):hover .np-song {
    color: var(--accent);
  }

  .np-artist {
    font-size: 0.8rem;
    color: var(--fg-dim);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  @media (max-width: 560px) {
    .np-inner {
      justify-content: flex-start;
    }
    .np-track {
      max-width: 100%;
    }
  }
</style>

<script define:vars={{ DISCORD_ID }}>
  const POLL_MS = 20000;

  const trackEl = document.getElementById("np-track");
  const songEl = document.getElementById("np-song");
  const artistEl = document.getElementById("np-artist");
  const artEl = document.getElementById("np-art");
  const eqEl = document.getElementById("np-eq");

  async function refresh() {
    if (!trackEl || !songEl || !artistEl || !artEl || !eqEl) return;
    try {
      const res = await fetch(`https://api.lanyard.rest/v1/users/${DISCORD_ID}`, {
        cache: "no-store",
      });
      const json = await res.json();
      if (!json.success) throw new Error("lanyard request failed");

      const data = json.data;
      if (data.listening_to_spotify && data.spotify) {
        const { song, artist, album_art_url, track_id } = data.spotify;
        songEl.textContent = song;
        artistEl.textContent = artist;
        artEl.src = album_art_url;
        artEl.hidden = false;
        trackEl.href = `https://open.spotify.com/track/${track_id}`;
        trackEl.classList.remove("np-idle");
        eqEl.classList.add("is-live");
      } else {
        setIdle();
      }
    } catch {
      setIdle();
    }
  }

  function setIdle() {
    if (!trackEl || !songEl || !artistEl || !artEl || !eqEl) return;
    songEl.textContent = "Not listening right now";
    artistEl.textContent = "";
    artEl.hidden = true;
    trackEl.removeAttribute("href");
    trackEl.classList.add("np-idle");
    eqEl.classList.remove("is-live");
  }

  refresh();
  setInterval(refresh, POLL_MS);
</script>
