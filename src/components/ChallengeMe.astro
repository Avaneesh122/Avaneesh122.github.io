---
interface Rank {
  name: string;
  division: number;
}

interface EndgameStat {
  label: string;
  value: string;
}

interface Game {
  name: string;
  tag: string | null;
  tagline: string;
  platform: string;
  cta: string;
  href: string | null;
  copyValue: string | null;
  rank: Rank | null;
  liveStats: "clash-royale" | null;
  endgame: EndgameStat[] | null;
}

const RANK_COLORS: Record<string, string> = {
  Rookie: "#8a8a86",
  Bronze: "#c17a45",
  Silver: "#b9bec4",
  Gold: "#e0b23c",
  Platinum: "#4fd1c5",
  Diamond: "#5aa9ff",
  Master: "#c77dff",
};

function toRoman(n: number): string {
  const table: [number, string][] = [
    [10, "X"], [9, "IX"], [5, "V"], [4, "IV"], [1, "I"],
  ];
  let remaining = n;
  let out = "";
  for (const [value, symbol] of table) {
    while (remaining >= value) {
      out += symbol;
      remaining -= value;
    }
  }
  return out || String(n);
}

const BADGE_R = 32;
const RING_R = 26;
const TICK_INNER = 22;
const TICK_COUNT = 12;
const rankTicks = Array.from({ length: TICK_COUNT }, (_, i) => {
  const angle = (i / TICK_COUNT) * 2 * Math.PI - Math.PI / 2;
  return {
    x1: BADGE_R + TICK_INNER * Math.cos(angle),
    y1: BADGE_R + TICK_INNER * Math.sin(angle),
    x2: BADGE_R + RING_R * Math.cos(angle),
    y2: BADGE_R + RING_R * Math.sin(angle),
  };
});

const games: Game[] = [
  {
    name: "Clash Royale",
    tag: "#2LUQ22P2C",
    tagline: "Add me and let's battle.",
    platform: "Mobile",
    cta: "Add Friend",
    href: "https://link.clashroyale.com/invite/friend/en?tag=2LUQ22P2C&token=axtw3twa&platform=iOS&m=0",
    copyValue: null,
    rank: null,
    liveStats: "clash-royale",
    endgame: null,
  },
  {
    name: "Yu-Gi-Oh! Master Duel",
    tag: "683-920-814",
    tagline: "Add me and let's duel.",
    platform: "Mobile / PC",
    cta: "Copy Friend ID",
    href: null,
    copyValue: "683-920-814",
    rank: { name: "Diamond", division: 4 },
    liveStats: null,
    endgame: null,
  },
  {
    name: "Honkai: Star Rail",
    tag: "806520857 · Asia",
    tagline: "Add me and let's clear some endgame.",
    platform: "Mobile / PC / PS5",
    cta: "Copy UID",
    href: null,
    copyValue: "806520857",
    rank: null,
    liveStats: null,
    endgame: [
      { label: "Memory of Chaos", value: "36 / 36 ★" },
      { label: "Pure Fiction", value: "12 / 12 ★" },
      { label: "Apocalyptic Shadow", value: "12 / 12 ★" },
      { label: "Anomaly Arbitration", value: "King ★3 · Knight ★9" },
    ],
  },
  {
    name: "Duolingo",
    tag: "@Avaneesh_12",
    tagline: "Follow along — currently learning Japanese.",
    platform: "Web / Mobile",
    cta: "View Profile",
    href: "https://www.duolingo.com/profile/Avaneesh_12",
    copyValue: null,
    rank: null,
    liveStats: null,
    endgame: [
      { label: "Day Streak", value: "1,155" },
      { label: "League", value: "Amethyst" },
    ],
  },
];
---

<section id="challenge" class="challenge shell">
  <div class="edge-pad challenge-head">
    <span class="section-label">05 / Challenge Me</span>
    <span class="mono challenge-note">Games I actually play — add me, let's run it back</span>
  </div>
  <div class="rule-dim"></div>
  <div class="edge-pad challenge-grid">
    {games.map((g) => (
      <div class="g-card">
        <div class="g-top mono">
          <span class="g-platform">{g.platform}</span>
          {g.tag && <span class="g-tag">{g.tag}</span>}
        </div>
        <h3 class="g-name">{g.name}</h3>
        <p class="g-tagline">{g.tagline}</p>
        {g.rank && (
          <div class="rank-row">
            <svg
              class="rank-badge"
              viewBox="0 0 64 64"
              aria-hidden="true"
              style={`--gem: ${RANK_COLORS[g.rank.name] ?? "var(--accent)"}`}
            >
              <circle cx="32" cy="32" r="30" class="rb-outer" />
              <circle cx="32" cy="32" r={RING_R} class="rb-ring" />
              {rankTicks.map((t) => (
                <line x1={t.x1} y1={t.y1} x2={t.x2} y2={t.y2} class="rb-tick" />
              ))}
              <polygon points="32,4 37,13 27,13" class="rb-spike" />
              <text x="32" y="39" text-anchor="middle" class="rb-num">
                {toRoman(g.rank.division)}
              </text>
            </svg>
            <span class="rank-meta">
              <span class="rank-label mono">Ranked</span>
              <span class="rank-text">
                {g.rank.name} {toRoman(g.rank.division)}
              </span>
            </span>
          </div>
        )}
        {g.liveStats === "clash-royale" && (
          <div class="rank-row" id="cr-stats" data-state="loading">
            <svg class="rank-badge" viewBox="0 0 64 64" aria-hidden="true" style="--gem: var(--accent)">
              <circle cx="32" cy="32" r="30" class="rb-outer" />
              <path
                class="rb-trophy"
                d="M22 14h20v6a10 10 0 0 1-20 0zM22 16h-6v3a6 6 0 0 0 6 5zM42 16h6v3a6 6 0 0 1-6 5zM30 33h4v5h-4zM24 40h16l-2 4H26z"
              />
            </svg>
            <span class="rank-meta">
              <span class="rank-label mono">Live · Ranked Ladder</span>
              <span class="rank-text" id="cr-trophies">—</span>
              <span class="cr-arena mono" id="cr-arena"></span>
            </span>
          </div>
        )}
        {g.endgame && (
          <div class="endgame-grid">
            {g.endgame.map((stat) => (
              <div class="eg-cell">
                <span class="eg-label mono">{stat.label}</span>
                <span class="eg-value">{stat.value}</span>
              </div>
            ))}
          </div>
        )}
        {g.href ? (
          <a class="btn btn-solid g-cta" href={g.href} target="_blank" rel="noreferrer">
            {g.cta} &nbsp;→
          </a>
        ) : g.copyValue ? (
          <button class="btn g-cta g-copy" type="button" data-copy={g.copyValue} data-copy-label={g.cta}>
            {g.cta}
          </button>
        ) : (
          <span class="btn g-cta g-cta-disabled" aria-disabled="true">
            {g.cta} coming soon
          </span>
        )}
      </div>
    ))}
  </div>
  <div class="rule"></div>
</section>

<style>
  .challenge {
    padding-top: clamp(3rem, 7vw, 5rem);
  }

  .challenge-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 1.6rem;
    flex-wrap: wrap;
    gap: 0.8rem;
  }

  .challenge-note {
    font-size: 0.76rem;
    color: var(--fg-dim);
  }

  .challenge-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1px;
    background: var(--line);
    padding-top: 1.6rem;
    padding-bottom: clamp(3rem, 7vw, 5rem);
  }

  @media (min-width: 640px) {
    .challenge-grid {
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    }
  }

  .g-card {
    display: flex;
    flex-direction: column;
    padding: clamp(1.6rem, 3vw, 2rem);
    background: var(--bg-raised);
    border: 1px solid var(--line);
  }

  .g-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.4rem;
  }

  .g-platform {
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-faint);
    border: 1px solid var(--line);
    padding: 0.25em 0.6em;
  }

  .g-tag {
    font-size: 0.72rem;
    color: var(--fg-faint);
    letter-spacing: 0.03em;
  }

  .g-name {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.3rem;
    margin: 0 0 0.6rem;
  }

  .g-tagline {
    color: var(--fg-dim);
    font-size: 0.9rem;
    line-height: 1.5;
    margin: 0 0 1.6rem;
    flex: 1;
  }

  .rank-row {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    margin: 0 0 1.4rem;
  }

  .rank-badge {
    width: 48px;
    height: 48px;
    flex-shrink: 0;
  }

  .rb-outer {
    fill: color-mix(in srgb, var(--gem) 10%, var(--bg-raised));
    stroke: var(--line);
    stroke-width: 1;
  }

  .rb-ring {
    fill: none;
    stroke: var(--gem);
    stroke-width: 1.5;
  }

  .rb-tick {
    stroke: color-mix(in srgb, var(--gem) 60%, transparent);
    stroke-width: 1.5;
  }

  .rb-spike {
    fill: var(--gem);
  }

  .rb-num {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 18px;
    fill: var(--gem);
  }

  .rank-meta {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .rank-label {
    font-size: 0.66rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg-faint);
  }

  .rank-text {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1rem;
    color: var(--fg);
  }

  .rb-trophy {
    fill: var(--gem);
  }

  .cr-arena {
    font-size: 0.72rem;
    color: var(--fg-dim);
  }

  #cr-stats[data-state="loading"] .rank-text {
    color: var(--fg-faint);
  }

  #cr-stats[data-state="error"] {
    display: none;
  }

  .endgame-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    margin: 0 0 1.6rem;
  }

  .eg-cell {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 0.7rem 0.8rem;
    background: var(--bg-raised);
    min-width: 0;
  }

  .eg-label {
    font-size: 0.62rem;
    letter-spacing: 0.04em;
    color: var(--fg-faint);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .eg-value {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 0.92rem;
    color: var(--accent);
    line-height: 1.3;
  }

  .g-cta {
    align-self: flex-start;
  }

  button.g-cta {
    font-family: var(--font-mono);
    cursor: pointer;
    background: transparent;
  }

  button.g-copy.is-copied {
    border-color: var(--accent);
    color: var(--accent);
  }

  .g-cta-disabled {
    color: var(--fg-faint);
    cursor: default;
  }

  .g-cta-disabled:hover {
    border-color: var(--line);
    color: var(--fg-faint);
  }
</style>

<script>
  async function loadClashRoyaleStats() {
    const root = document.getElementById("cr-stats");
    const trophiesEl = document.getElementById("cr-trophies");
    const arenaEl = document.getElementById("cr-arena");
    if (!root || !trophiesEl || !arenaEl) return;

    try {
      const res = await fetch("/clash-royale.json", { cache: "no-store" });
      const data = await res.json();

      if (typeof data.trophies !== "number") {
        // Stats file exists but the scheduled Action hasn't populated it yet.
        root.dataset.state = "error";
        return;
      }

      trophiesEl.textContent = `${data.trophies.toLocaleString()} trophies`;
      arenaEl.textContent = data.arenaName ? data.arenaName : "";
      root.dataset.state = "ready";
    } catch {
      root.dataset.state = "error";
    }
  }

  loadClashRoyaleStats();
  setInterval(loadClashRoyaleStats, 5 * 60 * 1000);

  document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((btn) => {
    const value = btn.dataset.copy;
    const label = btn.dataset.copyLabel ?? btn.textContent ?? "Copy";
    if (!value) return;

    btn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(value);
        btn.textContent = "Copied!";
        btn.classList.add("is-copied");
        setTimeout(() => {
          btn.textContent = label;
          btn.classList.remove("is-copied");
        }, 1600);
      } catch {
        btn.textContent = value;
      }
    });
  });
</script>
