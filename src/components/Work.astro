---
import ProjectCard from "./ProjectCard.astro";

const projects = [
  {
    index: "01",
    title: "Geometric Membership Inference Attacks on Tabular Diffusion Models",
    description:
      "Evaluates how much a TabDDPM diffusion model trained on cancer genomics data leaks about the patients it was trained on. Combines FLIPD local-intrinsic-dimension estimates, membership-inference proxies, and topological data analysis features, benchmarked across four overfitting regimes with sensitivity sweeps over feature selection, diffusion timesteps, noise samples, and weight decay.",
    tags: ["Python", "Diffusion Models", "Privacy / MIA", "TDA", "Genomics"],
    href: "https://github.com/Avaneesh122/geom-mia-tabular-diffusion",
    lang: "Python",
  },
  {
    index: "02",
    title: "Cancer Diagnostic Information Web App",
    description:
      "A web application that surfaces cancer diagnostic information through an integrated TEPSEG pipeline — connecting a research-grade segmentation and classification workflow to an interface a clinician or patient could actually use.",
    tags: ["Python", "Healthcare", "Web App", "TEPSEG"],
    href: "https://github.com/Avaneesh122/cancer_diagnostic_information_web_app",
    lang: "Python",
  },
];
---

<section id="work" class="work shell">
  <div class="edge-pad work-head">
    <span class="section-label">02 / Selected Work</span>
    <a class="mono all-repos" href="https://github.com/Avaneesh122?tab=repositories" target="_blank" rel="noreferrer">
      All repositories →
    </a>
  </div>
  <div class="rule-dim"></div>
  <div class="edge-pad work-grid">
    {projects.map((p) => <ProjectCard {...p} />)}
  </div>
  <div class="rule"></div>
</section>

<style>
  .work {
    padding-top: clamp(3rem, 7vw, 5rem);
  }

  .work-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 1.6rem;
    flex-wrap: wrap;
    gap: 0.8rem;
  }

  .all-repos {
    font-size: 0.78rem;
    color: var(--fg-dim);
    text-decoration: none;
  }

  .all-repos:hover {
    color: var(--accent);
  }

  .work-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1px;
    background: var(--line);
    padding-top: 1.6rem;
    padding-bottom: clamp(3rem, 7vw, 5rem);
  }

  @media (min-width: 760px) {
    .work-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
